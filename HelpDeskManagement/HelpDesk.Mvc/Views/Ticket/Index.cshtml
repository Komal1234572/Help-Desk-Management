@model List<HelpDesk.Mvc.Models.Ticket>
@{
    ViewData["Title"] = "All Tickets";
}

<h1>All Tickets</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Raise New Ticket</a>
</p>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Raised By</th>
                <th>Created Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Id</td>
                <td>@ticket.Title</td>
                <td>@ticket.Priority</td>
                <td>@ticket.Status</td>
                <td>@ticket.RaisedBy</td>
                <td>@ticket.CreatedDate.ToString("dd-MMM-yyyy")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@ticket.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@ticket.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No tickets found.</p>
}
