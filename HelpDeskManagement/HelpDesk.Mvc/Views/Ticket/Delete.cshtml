@model HelpDesk.Mvc.Models.Ticket
@{
    ViewData["Title"] = "Delete Ticket";
}

<h1>Delete Ticket</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this ticket? This action cannot be undone.
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Priority</dt>
            <dd class="col-sm-9">@Model.Priority</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Raised By</dt>
            <dd class="col-sm-9">@Model.RaisedBy</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
